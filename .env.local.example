NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# PortOne V2 + Toss Payments (테스트 연동, https://admin.portone.io)
# storeId/channelKey는 브라우저에 노출되어도 되는 값(카드 결제 시크릿 아님)이라 NEXT_PUBLIC_ 접두사를 사용한다.
# PORTONE_API_SECRET은 절대 브라우저로 보내지 않는다 — 서버(빌링키 결제 확정 API)에서만 사용.
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=

# 정기결제 스케줄러(/api/cron/billing) 인증용 임의 문자열. Vercel Cron은 이 값을
# CRON_SECRET 환경변수로 설정해두면 Authorization: Bearer <값> 헤더를 자동으로
# 붙여 보낸다. 로컬 테스트도 동일한 값을 Authorization 헤더에 넣어 호출하면 된다.
CRON_SECRET=

# NAVER Commerce API (operator SELF app, dev/local only for now). The client secret is a
# bcrypt salt that starts with $2a$10$ — Next expands "$" in .env files, so write every
# "$" as \$ here (Vercel env vars need no escaping).
NAVER_COMMERCE_CLIENT_ID=
NAVER_COMMERCE_CLIENT_SECRET=
NAVER_COMMERCE_STORE_SLUG=
NAVER_COMMERCE_OPERATOR_USER_IDS=
